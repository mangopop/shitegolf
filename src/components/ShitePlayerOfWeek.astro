---
// A full-screen entry gate, shown right after arrival: an unwanted weekly
// "honour" announcing a real name from this year's field (same pick for
// everyone, all week - reshuffles next Monday). You must accept it before
// the rest of the site unlocks.
import Headshot from './Headshot.astro';
import type { PlayerFile } from '../lib/site';

interface Props {
  players: Record<string, PlayerFile>;
  participantSlugs: string[];
}
const { players, participantSlugs } = Astro.props;

// ISO week number, so the pick is stable Monday-to-Sunday and changes over.
function isoWeekKey(d: Date): string {
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
  const week = Math.ceil(((date.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
  return `${date.getUTCFullYear()}-w${week}`;
}

function hash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}

const now = new Date();
const weekKey = isoWeekKey(now);
const pickSlug = participantSlugs[hash(weekKey) % participantSlugs.length]!;
const player = players[pickSlug]!;

// A pool of unearned, unrelated verdicts on their golf this week - true or
// not, it doesn't matter, they're getting one. Hashed separately from the
// player pick so the line and the victim don't always move together.
const verdicts = [
  'Reportedly once lost a ball on the practice green.',
  "Handicap: yes.",
  'Plays golf the way seagulls fly kites.',
  "Hasn't touched a club this week, and it still would've been an improvement.",
  'Scouts describe the swing as "technically golf."',
  'Was seen practising. It did not help.',
  'Currently rated one star, would not recommend.',
  'Has not golfed this week, which is the correct decision.',
  'Golfed this week. Everyone involved regrets it.',
  'Under investigation for crimes against the fairway.',
  'The ball goes where it wants. This player just watches.',
  'Coaches have stopped offering advice out of respect for the family.',
];
const verdict = verdicts[hash(`${weekKey}-verdict`) % verdicts.length]!;
---

<div class="sotw" id="sotw" role="dialog" aria-label="Shite Player of the Week" hidden data-week={weekKey}>
  <div class="sotw-confetti" aria-hidden="true">
    {Array.from({ length: 24 }).map((_, i) => <span class="bit" style={`--i:${i}`} />)}
  </div>
  <div class="sotw-card">
    <div class="sotw-title">🏆 SHITE PLAYER OF THE WEEK 🏆</div>
    <div class="sotw-headshot"><Headshot player={player} /></div>
    <div class="sotw-name">{player.name}</div>
    <div class="sotw-verdict">{verdict}</div>
    <div class="sotw-congrats blink-text">CONGRATULATIONS.</div>

    <button type="button" id="sotw-accept" class="sotw-accept">I ACKNOWLEDGE THIS PERSON IS SHITE AT GOLF.</button>
  </div>
</div>

<script>
  const gate = document.getElementById('sotw');
  const acceptBtn = document.getElementById('sotw-accept');

  const STORAGE_KEY = 'shitegolf-sotw-passed';

  if (gate && acceptBtn) {
    if (sessionStorage.getItem(STORAGE_KEY)) {
      gate.remove();
    } else {
      const reveal = () => {
        gate.hidden = false;
        document.body.style.overflow = 'hidden';
      };

      // Wait for the mini-golf gate to finish (win or give up) before this
      // one takes over - only one full-screen gate should be up at a time.
      const golfgate = document.getElementById('golfgate');
      if (golfgate) {
        const observer = new MutationObserver(() => {
          if (!document.getElementById('golfgate')) {
            observer.disconnect();
            reveal();
          }
        });
        observer.observe(document.body, { childList: true, subtree: true });
      } else {
        reveal();
      }

      acceptBtn.addEventListener('click', () => {
        sessionStorage.setItem(STORAGE_KEY, '1');
        gate.classList.add('hide');
        document.body.style.overflow = '';
        setTimeout(() => gate.remove(), 400);
      });
    }
  }
</script>

<style>
  .sotw {
    position: fixed;
    inset: 0;
    z-index: 10002;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(0, 0, 0, 0.7);
    opacity: 1;
    transition: opacity 0.4s;
  }
  .sotw[hidden] {
    display: none;
  }
  .sotw.hide {
    opacity: 0;
    pointer-events: none;
  }
  .sotw-confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sotw-confetti .bit {
    position: absolute;
    top: -10%;
    left: calc(var(--i) * 4.2%);
    width: 8px;
    height: 14px;
    background: hsl(calc(var(--i) * 37), 90%, 55%);
    animation: sotw-fall 2.6s linear calc(var(--i) * 0.08s) infinite;
    opacity: 0.9;
  }
  @keyframes sotw-fall {
    from {
      transform: translateY(-10vh) rotate(0deg);
    }
    to {
      transform: translateY(110vh) rotate(360deg);
    }
  }
  .sotw-card {
    position: relative;
    width: min(360px, 100%);
    text-align: center;
    background: var(--paper-3);
    border: 4px ridge var(--gold-bright);
    padding: 22px 18px 20px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  }
  .sotw-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 18px;
    color: var(--red);
    margin-bottom: 14px;
  }
  .sotw-headshot {
    width: 96px;
    height: 96px;
    margin: 0 auto 12px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--gold-bright);
  }
  .sotw-name {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .sotw-verdict {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .sotw-line {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
  }
  .sotw-congrats {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 16px;
    color: var(--gold-bright);
    margin-top: 10px;
    margin-bottom: 18px;
  }
  .sotw-accept {
    display: block;
    width: 100%;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    color: #000;
    background: var(--gold-bright);
    border: 2px outset #fff;
    padding: 10px 12px;
    cursor: pointer;
  }
  .sotw-accept:hover {
    animation: flash-border 0.3s steps(1) infinite;
  }
  .sotw-accept:active {
    border-style: inset;
  }
  @media (prefers-reduced-motion: reduce) {
    .sotw {
      transition: none;
    }
    .sotw-confetti .bit {
      animation: none;
      display: none;
    }
  }
</style>

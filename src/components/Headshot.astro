---
// A player's headshot, or a monogram placeholder in site style.
import type { PlayerFile } from '../lib/site';
import { photo } from '../lib/paths';

interface Props {
  player: PlayerFile;
}
const { player } = Astro.props;
const initials = player.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
---

{
  player.headshot ? (
    <img class="headshot" src={photo(`players/${player.headshot}`)} alt={`Headshot of ${player.name}`} />
  ) : (
    <div class="headshot monogram" aria-label={player.name}>
      <span>{initials}</span>
    </div>
  )
}

<style>
  .headshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(212, 160, 23, 0.14), transparent 60%),
      linear-gradient(180deg, #123526, #0b2418);
  }
  .monogram span {
    font-family: var(--serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(28px, 5vw, 56px);
    color: var(--gold);
    opacity: 0.85;
  }
</style>

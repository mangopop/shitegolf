---
// A joke "entry gate" for the homepage: an unwinnable mini putting game.
// The ball is physically incapable of going in - however you aim, it lips
// out - and the only way through is to click "I give up" and admit defeat.
---

<div class="golfgate" id="golfgate" hidden>
  <div class="golfgate-inner">
    <div class="golfgate-title blink-text">⛳ PROVE YOU'RE WORTHY OF SHITEGOLF.CO.UK ⛳</div>
    <div class="golfgate-sub" id="golfgate-sub">Sink a putt to enter. Click and drag from the ball to aim, then let go.</div>

    <canvas id="golfgate-canvas" width="320" height="420" aria-label="An unwinnable mini golf hole"></canvas>

    <div class="golfgate-stats">
      Attempts: <span id="golfgate-attempts">0</span> · Sunk: <span id="golfgate-sunk">0</span>
    </div>

    <div class="golfgate-give-up">
      <button type="button" id="golfgate-quit">Okay, I'm shite at golf. I give up.</button>
    </div>
  </div>
</div>

<script>
  const gate = document.getElementById('golfgate');
  const canvas = document.getElementById('golfgate-canvas') as HTMLCanvasElement | null;
  const subEl = document.getElementById('golfgate-sub');
  const attemptsEl = document.getElementById('golfgate-attempts');
  const sunkEl = document.getElementById('golfgate-sunk');
  const quitBtn = document.getElementById('golfgate-quit');

  const STORAGE_KEY = 'shitegolf-gate-passed';

  if (gate && canvas && subEl && attemptsEl && quitBtn) {
    if (sessionStorage.getItem(STORAGE_KEY)) {
      gate.remove();
    } else {
      gate.hidden = false;
      document.body.style.overflow = 'hidden';

      const ctx = canvas.getContext('2d')!;
      const W = canvas.width;
      const H = canvas.height;
      const HOLE = { x: W / 2, y: 64, r: 10 };
      const FIELD_R = 54; // radius at which the hole starts gently bending the ball's path
      const MIN_D = HOLE.r + 9; // closest the ball is ever allowed to get to the cup centre
      const START = { x: W / 2, y: H - 48 };

      let ball = { x: START.x, y: START.y, vx: 0, vy: 0 };
      let moving = false;
      let dragging = false;
      let dragStart = { x: 0, y: 0 };
      let dragNow = { x: 0, y: 0 };
      let attempts = 0;
      let raf = 0;

      const excuses = [
        'Lipped out. Tradition upheld.',
        'So close. Not really.',
        'The hole moved. Definitely the hole.',
        "That's your handicap talking.",
        'Physics has intervened.',
        'A gust of wind. Indoors.',
        'The green just isn’t true, this one.',
        'Somehow worse than the last one.',
      ];

      function reduceMotion() {
        return matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      function drawGreen() {
        ctx.fillStyle = '#0d7536';
        ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = 'rgba(255,255,255,0.15)';
        ctx.lineWidth = 1;
        for (let y = 20; y < H; y += 20) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        }
      }

      function drawHole() {
        ctx.beginPath();
        ctx.arc(HOLE.x, HOLE.y, HOLE.r, 0, Math.PI * 2);
        ctx.fillStyle = '#031a0c';
        ctx.fill();
        // flag
        ctx.strokeStyle = '#c0c0c0';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(HOLE.x, HOLE.y - 2);
        ctx.lineTo(HOLE.x, HOLE.y - 50);
        ctx.stroke();
        ctx.fillStyle = '#7a1620';
        ctx.beginPath();
        ctx.moveTo(HOLE.x, HOLE.y - 50);
        ctx.lineTo(HOLE.x + 20, HOLE.y - 44);
        ctx.lineTo(HOLE.x, HOLE.y - 38);
        ctx.closePath();
        ctx.fill();
      }

      function drawBall() {
        ctx.beginPath();
        ctx.arc(ball.x, ball.y, 7, 0, Math.PI * 2);
        ctx.fillStyle = '#f4f0d8';
        ctx.strokeStyle = 'rgba(0,0,0,0.4)';
        ctx.lineWidth = 1;
        ctx.fill();
        ctx.stroke();
      }

      function drawAim() {
        if (!dragging) return;
        ctx.strokeStyle = 'rgba(255, 210, 63, 0.9)';
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.moveTo(ball.x, ball.y);
        ctx.lineTo(dragNow.x, dragNow.y);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      function render() {
        drawGreen();
        drawHole();
        drawAim();
        drawBall();
      }

      function resetBall() {
        ball = { x: START.x, y: START.y, vx: 0, vy: 0 };
        moving = false;
        render();
      }

      function pos(e: PointerEvent) {
        const rect = canvas.getBoundingClientRect();
        return { x: (e.clientX - rect.left) * (W / rect.width), y: (e.clientY - rect.top) * (H / rect.height) };
      }

      canvas.addEventListener('pointerdown', (e) => {
        if (moving) return;
        dragging = true;
        dragStart = pos(e);
        dragNow = dragStart;
        canvas.setPointerCapture(e.pointerId);
      });

      canvas.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        dragNow = pos(e);
        render();
      });

      canvas.addEventListener('pointerup', (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = dragNow.x - ball.x;
        const dy = dragNow.y - ball.y;
        const dist = Math.min(Math.hypot(dx, dy), 90);
        if (dist < 6) {
          render();
          return;
        }
        const power = dist / 90;
        ball.vx = (dx / dist) * power * 11;
        ball.vy = (dy / dist) * power * 11;
        moving = true;
        attempts++;
        attemptsEl!.textContent = String(attempts);
        subEl!.textContent = 'In flight. Bravely.';
        cancelAnimationFrame(raf);
        step();
      });

      function step() {
        // The hole quietly bends the ball's path as it passes nearby, rather
        // than deflecting it on contact - a gentle curve that reads as a
        // near-miss instead of a bounce off an invisible wall.
        const dhx = ball.x - HOLE.x;
        const dhy = ball.y - HOLE.y;
        const dh = Math.hypot(dhx, dhy);
        if (dh < FIELD_R && dh > 0.01) {
          const nx = dhx / dh;
          const ny = dhy / dh;
          const tx = -ny;
          const ty = nx;
          const strength = 1 - dh / FIELD_R;
          const sign = ball.vx * tx + ball.vy * ty >= 0 ? 1 : -1;
          const curveAccel = strength * strength * 0.5;
          const pullAccel = strength * 0.1;
          ball.vx += tx * sign * curveAccel - nx * pullAccel;
          ball.vy += ty * sign * curveAccel - ny * pullAccel;
        }

        // Friction.
        ball.vx *= 0.985;
        ball.vy *= 0.985;
        ball.x += ball.vx;
        ball.y += ball.vy;

        // Wall bounce.
        if (ball.x < 8) {
          ball.x = 8;
          ball.vx *= -0.7;
        }
        if (ball.x > W - 8) {
          ball.x = W - 8;
          ball.vx *= -0.7;
        }
        if (ball.y < 8) {
          ball.y = 8;
          ball.vy *= -0.7;
        }
        if (ball.y > H - 8) {
          ball.y = H - 8;
          ball.vy *= -0.7;
        }

        // Hard floor: whatever happens above, the ball can never actually
        // reach the cup - it grazes the rim and keeps rolling.
        const rhx = ball.x - HOLE.x;
        const rhy = ball.y - HOLE.y;
        const rh = Math.hypot(rhx, rhy);
        if (rh < MIN_D && rh > 0.01) {
          const nx = rhx / rh;
          const ny = rhy / rh;
          ball.x = HOLE.x + nx * MIN_D;
          ball.y = HOLE.y + ny * MIN_D;
          const vn = ball.vx * nx + ball.vy * ny;
          if (vn < 0) {
            ball.vx -= vn * nx;
            ball.vy -= vn * ny;
          }
        }

        const speed = Math.hypot(ball.vx, ball.vy);
        render();

        if (speed > 0.15) {
          raf = requestAnimationFrame(step);
        } else {
          moving = false;
          const msg = excuses[Math.floor(Math.random() * excuses.length)];
          subEl!.textContent = msg;
          setTimeout(resetBall, reduceMotion() ? 0 : 650);
        }
      }

      render();

      quitBtn.addEventListener('click', () => {
        sessionStorage.setItem(STORAGE_KEY, '1');
        cancelAnimationFrame(raf);
        gate.classList.add('hide');
        document.body.style.overflow = '';
        setTimeout(() => gate.remove(), 400);
      });
    }
  }
</script>

<style>
  .golfgate {
    position: fixed;
    inset: 0;
    z-index: 10001;
    background: var(--paper-2);
    background-image: repeating-linear-gradient(90deg, #0a3d1f 0 40px, #0d5028 40px 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 1;
    transition: opacity 0.4s;
  }
  .golfgate.hide {
    opacity: 0;
    pointer-events: none;
  }
  .golfgate-inner {
    width: min(360px, 100%);
    text-align: center;
    background: var(--paper-3);
    border: 4px ridge var(--gold-bright);
    padding: 16px;
  }
  .golfgate-title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    color: var(--red);
    margin-bottom: 6px;
  }
  .golfgate-sub {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--ink);
    min-height: 32px;
    margin-bottom: 10px;
  }
  #golfgate-canvas {
    width: 100%;
    height: auto;
    max-width: 320px;
    border: 3px outset #c0c0c0;
    touch-action: none;
    cursor: crosshair;
  }
  .golfgate-stats {
    font-family: var(--mono);
    font-size: 11px;
    margin: 10px 0;
    color: var(--paper-2);
  }
  .golfgate-give-up {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--ink);
    border-top: 1px dashed var(--hairline);
    padding-top: 10px;
  }
  #golfgate-quit {
    display: block;
    margin: 8px auto 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    color: #000;
    background: var(--gold-bright);
    border: 2px outset #fff;
    padding: 6px 12px;
    cursor: pointer;
  }
  #golfgate-quit:hover {
    animation: flash-border 0.3s steps(1) infinite;
  }
  #golfgate-quit:active {
    border-style: inset;
  }
  @media (prefers-reduced-motion: reduce) {
    .golfgate {
      transition: none;
    }
  }
</style>
